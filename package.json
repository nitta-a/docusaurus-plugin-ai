{
  "name": "@docusaurus-plugin-ai/core",
  "version": "0.4.1",
  "packageManager": "pnpm@11.24.0",
  "description": "A vendor-neutral AI foundation for Docusaurus documentation search and Q&A.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nitta-a/docusaurus-plugin-ai"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "require": "./dist/plugin.cjs"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && pnpm --dir packages/ui build",
    "clean": "rm -rf dist",
    "demo:build": "pnpm build && pnpm --dir demo build",
    "demo:start": "pnpm build && pnpm --dir demo start",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "audit:prod": "pnpm audit --prod",
    "lint": "biome check .",
    "release:check": "node scripts/check-release-version.mjs",
    "test": "vitest run && pnpm --dir packages/ui test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && pnpm --dir packages/ui typecheck"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@docusaurus/types": "3.10.2",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.65",
    "ai": "^7.0.97"
  }
}
